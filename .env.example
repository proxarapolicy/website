# REQUIRED AT BUILD TIME. `next build` fails with "Missing environment variable"
# if either is absent, so they must be set in the hosting provider (Vercel →
# Settings → Environment Variables) as well as locally in .env.local.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# The same two values under the prefix the Sanity CLI inlines when building the
# hosted Studio (`npx sanity deploy`). Needed locally only — not on Vercel.
SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"
# Canonical site URL, e.g. https://proxarapolicy.com in production
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only. Editor token used by scripts/seed.ts (never exposed to the browser).
SANITY_API_WRITE_TOKEN=""

# Email notifications for the contact form via Resend. Site works without it —
# without a key, enquiries are written to the server log instead of emailed.
RESEND_API_KEY=""

# Sender address for those notifications. Must be on a domain verified in
# Resend, e.g. "Proxara Policy Website <website@send.proxarapolicy.com>".
# Without it, the code falls back to Resend's onboarding@resend.dev, which only
# delivers to the Resend account owner's own address.
RESEND_FROM=""

# Shared secret for the Sanity revalidation webhook (/api/revalidate).
SANITY_REVALIDATE_SECRET=""

# Google reCAPTCHA v3 (invisible) for the contact form.
# Create a v3 key pair at https://www.google.com/recaptcha/admin — add both
# localhost and your production domain. Without these, the form still works
# (honeypot + time trap only); with the secret set, verification is required.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
